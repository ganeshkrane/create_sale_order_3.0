{
  "_version": "1.12.0",
  "sap.app": {
    "id": "sap.ui.salesorder.store",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "title": "{{appTitle}}",
    "description": "{{appSubtitle}}",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "customersMock": {
        "uri": "model/mockdata/customers.json",
        "type": "JSON"
      },
      "addressesMock": {
        "uri": "model/mockdata/addresses.json",
        "type": "JSON"
      },
      "orderTypesMock": {
        "uri": "model/mockdata/orderTypes.json",
        "type": "JSON"
      },
      "productsMock": {
        "uri": "model/mockdata/products.json",
        "type": "JSON"
      },
      "consentChannelsMock": {
        "uri": "model/mockdata/consentChannels.json",
        "type": "JSON"
      },
      "deliveryMethodsMock": {
        "uri": "model/mockdata/deliveryMethods.json",
        "type": "JSON"
      },
      "ZECC_ARTICLELIST_SRV_01": {
        "uri": "/sap/opu/odata/sap/ZECC_ARTICLELIST_SRV_01/",
        "type": "OData",
        "settings": {
          "odataVersion": "2.0",
          "localUri": "localService/ZECC_ARTICLELIST_SRV_01/ARTICLELIST_metadata.xml"
        }
      },
      "articleListMock": {
        "uri": "model/mockdata/articleList.json",
        "type": "JSON"
      },
      "ZCRM_ORIGINATIONS_SRV": {
        "uri": "/sap/opu/odata/sap/ZCRM_ORIGINATIONS_SRV/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/ZCRM_ORIGINATIONS_SRV/metadata.xml",
          "odataVersion": "2.0"
        }
      },
      "ZSRA017_SALESORDER_CREATE_SRV": {
        "uri": "/sap/opu/odata/sap/ZSRA017_SALESORDER_CREATE_SRV/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/ZSRA017_SALESORDER_CREATE_SRV/metadata.xml",
          "odataVersion": "2.0"
        }
      },
      "ZCUSTOMER_OVERVIEW_SRV": {
        "uri": "/sap/opu/odata/sap/ZCUSTOMER_OVERVIEW_NEW_SRV/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/ZCUSTOMER_OVERVIEW_NEW_SRV/metadata.xml",
          "odataVersion": "2.0"
        }
      },
      "ZCRM_CUSTOMER_MANAGE_SRV": {
        "uri": "/sap/opu/odata/sap/ZCRM_CUSTOMER_MANAGE_SRV/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/ZCRM_CUSTOMER_MANAGE_SRV/metadata.xml",
          "odataVersion": "2.0"
        }
      }
    },
    "sourceTemplate": {
      "id": "@sap/ux-app-migrator:freestyle",
      "version": "1.33.0",
      "toolsId": "563ecfb2-4f02-4a43-b4f0-5e62e4ebed57"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "sap.ui.salesorder.store.view.App",
      "type": "XML",
      "async": true,
      "id": "app"
    },
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.layout": {},
        "sap.ui.unified": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "sap.ui.salesorder.store.i18n.i18n",
          "supportedLocales": [
            "",
            "en",
            "de"
          ],
          "fallbackLocale": ""
        }
      },
      "customers": {
        "type": "sap.ui.model.json.JSONModel",
        "dataSource": "customersMock"
      },
      "addresses": {
        "type": "sap.ui.model.json.JSONModel",
        "dataSource": "addressesMock"
      },
      "orderTypes": {
        "type": "sap.ui.model.json.JSONModel",
        "dataSource": "orderTypesMock"
      },
      "products": {
        "type": "sap.ui.model.json.JSONModel",
        "dataSource": "productsMock"
      },
      "articleOData": {
        "type": "sap.ui.model.odata.v2.ODataModel",
        "dataSource": "ZECC_ARTICLELIST_SRV_01",
        "settings": {
          "defaultBindingMode": "TwoWay",
          "useBatch": false
        }
      },
      "artList": {
        "type": "sap.ui.model.json.JSONModel",
        "dataSource": "articleListMock"
      },
      "consentChannels": {
        "type": "sap.ui.model.json.JSONModel",
        "dataSource": "consentChannelsMock"
      },
      "deliveryMethods": {
        "type": "sap.ui.model.json.JSONModel",
        "dataSource": "deliveryMethodsMock"
      },
      "ZCRM_ORIGINATIONS_SRV": {
        "dataSource": "ZCRM_ORIGINATIONS_SRV",
        "preload": true,
        "settings": {}
      },
      "ZSRA017_SALESORDER_CREATE_SRV": {
        "dataSource": "ZSRA017_SALESORDER_CREATE_SRV",
        "preload": true,
        "settings": {}
      },
      "ZCUSTOMER_OVERVIEW_SRV": {
        "dataSource": "ZCUSTOMER_OVERVIEW_SRV",
        "preload": true,
        "settings": {}
      },
      "ZCRM_CUSTOMER_MANAGE_SRV": {
        "dataSource": "ZCRM_CUSTOMER_MANAGE_SRV",
        "preload": true,
        "settings": {}
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        },
        {
          "uri": "css/address-capture.css"
        }
      ],
      "js": [
        {
          "uri": "utils/address-capture.mock.iife.js"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "viewPath": "sap.ui.salesorder.store.view",
        "controlId": "appNavContainer",
        "controlAggregation": "pages",
        "async": true
      },
      "routes": [
        {
          "name": "customerWizard",
          "pattern": "",
          "target": "customerWizard"
        },
        {
          "name": "salesOrderList",
          "pattern": "orders",
          "target": "salesOrderList"
        },
        {
          "name": "salesOrderDetail",
          "pattern": "orders/{orderId}",
          "target": "salesOrderDetail"
        }
      ],
      "targets": {
        "customerWizard": {
          "viewName": "CustomerWizard",
          "viewId": "customerWizardView",
          "viewLevel": 1
        },
        "salesOrderList": {
          "viewName": "SalesOrderList",
          "viewId": "salesOrderListView",
          "viewLevel": 2
        },
        "salesOrderDetail": {
          "viewName": "SalesOrderDetail",
          "viewId": "salesOrderDetailView",
          "viewLevel": 3
        }
      }
    }
  }
}
