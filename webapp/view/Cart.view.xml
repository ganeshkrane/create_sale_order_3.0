<mvc:View
  controllerName="sap.ui.salesorder.store.controller.Cart"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core">
  <Page
    id="cartPage"
    title="{i18n>cartTitle}"
    showNavButton="true"
    navButtonPress=".onNavBack">
    <headerContent>
    </headerContent>
    <content>
      <!-- Guided Step Header -->
      <core:Fragment fragmentName="sap.ui.salesorder.store.view.fragments.StepIndicator" type="XML" />

      <VBox class="sapUiResponsiveMargin">
        <Breadcrumbs>
          <Link text="{i18n>shellHome}" press=".onNavHome" />
          <Link text="{i18n>productsTitle}" press=".onNavToProducts" />
          <Text text="{i18n>cartTitle}" />
        </Breadcrumbs>
        <Title text="{i18n>cartTitle}" titleStyle="H3" class="sapUiTinyMarginTop" />
        <Text text="{i18n>cartStepIndicator}" class="sapUiThemeColor-dim" />

        <!-- Customer Summary Card -->
        <core:Fragment fragmentName="sap.ui.salesorder.store.view.fragments.CustomerHeader" type="XML" />

        <!-- Cart Items Table -->
        <Panel
          expandable="false"
          expanded="true"
          class="fioriStandardBorderPanel sapUiSmallMarginTop">
          <headerToolbar>
            <Toolbar>
              <Title
                text="{= 'Cart Items (' + ${appState>/cart}.length + ')' }"
                titleStyle="H5"
                class="sapUiSmallMarginEnd" />
              <ToolbarSpacer />
              <Button
                id="btnCartAddArticle"
                text="Add Article"
                icon="sap-icon://add"
                type="Emphasized"
                press=".onOpenAddArticleDialog" />
            </Toolbar>
          </headerToolbar>
          <content>
            <ScrollContainer
              horizontal="true"
              vertical="false"
              width="100%">
              <Table
                id="cartItemsTable"
                items="{appState>/cart}"
                noDataText="Your cart is currently empty. Please choose Add More Products.">
                <columns>
                  <Column width="65px" hAlign="Center">
                    <Text text="Item" />
                  </Column>
                  <Column width="110px">
                    <Text text="Article" />
                  </Column>
                  <Column width="100px" hAlign="Center">
                    <Text text="Target Qty" />
                  </Column>
                  <Column width="65px" hAlign="Center">
                    <Text text="UM" />
                  </Column>
                  <Column width="220px">
                    <Text text="Description" />
                  </Column>
                  <Column width="110px">
                    <Text text="Product No." />
                  </Column>
                  <Column width="110px">
                    <Text text="" />
                  </Column>
                  <Column width="115px" hAlign="End">
                    <Text text="Price/Unit" />
                  </Column>
                  <Column width="115px" hAlign="End">
                    <Text text="Item Price" />
                  </Column>
                  <Column width="125px" hAlign="Center">
                    <Text text="Sales Person ID" />
                  </Column>
                  <Column width="80px" hAlign="Center">
                    <Text text="Site" />
                  </Column>
                  <Column width="115px" hAlign="Center">
                    <Text text="Item Category" />
                  </Column>
                  <Column width="150px">
                    <Text text="Extended Guarantee Product" />
                  </Column>
                  <Column width="180px">
                    <Text text="Rej. Reason" />
                  </Column>
                  <Column width="65px" hAlign="Center">
                    <Text text="Action" />
                  </Column>
                </columns>
                <items>
                  <ColumnListItem class="{= ${appState>isSubItem} ? 'subItemRow' : 'mainItemRow' }">
                    <cells>
                      <Text text="{appState>item}" />
                      <Text text="{appState>articleId}" />
                      <HBox alignItems="Center" justifyContent="Center">
                        <Button
                          icon="sap-icon://less"
                          type="Transparent"
                          press=".onDecreaseQty"
                          enabled="{= ${appState>qty} > 1 }" />
                        <Text text="{appState>qty}" class="sapUiTinyMarginBeginEnd" />
                        <Button
                          icon="sap-icon://add"
                          type="Transparent"
                          press=".onIncreaseQty" />
                      </HBox>
                      <Text text="{= ${appState>um} || 'EA' }" />
                      <Text text="{= ${appState>description} || ${appState>name} }" class="productTableTitle" />
                      <Text text="{= ${appState>productNo} || 'PRD-' + ${appState>articleId} }" />
                      <Link
                        text="value-add"
                        press=".onOpenValueAddPopup"
                        visible="{= !${appState>isSubItem} &amp;&amp; !${appState>isValueAdd} }" />
                      <Text text="{path: 'appState>netPrice', formatter: '.formatter.formatCurrency'}" />
                      <Text text="{path: 'appState>netValue', formatter: '.formatter.formatCurrency'}" class="priceTextBold" />
                      <Text text="{= ${appState>salesPersonId} || 'SP-1042' }" />
                      <Text text="{= ${appState>site} || 'S101' }" />
                      <Text text="{appState>itemCat}" />
                      <Text text="{= ${appState>extendedGuarantee} || (${appState>isSubItem} ? 'ZEGP-24' : '-') }" />
                      <Select
                        selectedKey="{appState>rejReason}"
                        width="100%"
                        change=".onRejectionReasonChange">
                        <core:Item key="-" text="- None -" />
                        <core:Item key="01" text="01 - Out of Stock" />
                        <core:Item key="02" text="02 - Customer Cancellation" />
                        <core:Item key="03" text="03 - Price Dispute" />
                        <core:Item key="04" text="04 - Damaged Goods" />
                        <core:Item key="05" text="05 - Late Delivery" />
                        <core:Item key="06" text="06 - Alternative Item" />
                      </Select>
                      <Button
                        icon="sap-icon://delete"
                        type="Transparent"
                        tooltip="Delete Line Item"
                        press=".onRemoveCartItem" />
                    </cells>
                  </ColumnListItem>
                </items>
              </Table>
            </ScrollContainer>

            <!-- Value-added note banner matching Screen 10 -->
            <HBox
              class="valueAddedNoteBox sapUiSmallMargin"
              alignItems="Center">
              <core:Icon src="sap-icon://information" class="sapUiTinyMarginEnd" color="#d15a00" />
              <Text text="{i18n>valueAddedNote}" class="valueAddedNoteText" />
            </HBox>
          </content>
        </Panel>

        <!-- Backend Info Strip -->
        <HBox class="backendInfoStrip sapUiMediumMarginTop" alignItems="Center">
          <core:Icon src="sap-icon://database" class="sapUiTinyMarginEnd" color="#107e3e" />
          <Text text="BACKEND: ZSra017_Products (pricing simulation)." />
        </HBox>
      </VBox>
    </content>
    <footer>
      <OverflowToolbar>
        <ToolbarSpacer />
        <Button
          id="btnNextPricing"
          text="{i18n>nextPricingBtn}"
          type="Emphasized"
          press=".onNextToPricing" />
        <Button
          id="btnAddMoreProducts"
          text="{i18n>addMoreProductsBtn}"
          icon="sap-icon://add"
          press=".onNavToProducts" />
      </OverflowToolbar>
    </footer>
  </Page>
</mvc:View>
