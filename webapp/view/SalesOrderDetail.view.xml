<mvc:View
  controllerName="sap.ui.salesorder.store.controller.SalesOrderDetail"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:l="sap.ui.layout"
  xmlns:u="sap.ui.unified">
  <Page
    id="salesOrderDetailPage"
    title="Sales Order Details"
    showNavButton="true"
    navButtonPress=".onNavBack"
    class="sapUiResponsiveContentPadding">
    <headerContent>
      <!-- When in View mode -->
      <Button
        id="btnBackToList"
        text="Back to Orders List"
        icon="sap-icon://nav-back"
        press=".onNavBack"
        visible="{= !${ui>/isEditMode} }"
        class="cursorPointer sapUiTinyMarginEnd" />
      <Button
        id="btnEditOrder"
        text="Edit Sales Order"
        icon="sap-icon://edit"
        type="Default"
        press=".onEditOrder"
        visible="{= !${ui>/isEditMode} }"
        class="cursorPointer sapUiTinyMarginEnd" />
      <Button
        id="btnCreateNewOrderFromDetail"
        text="New Sales Order"
        icon="sap-icon://add"
        type="Emphasized"
        press=".onCreateNewOrder"
        visible="{= !${ui>/isEditMode} }"
        class="cursorPointer" />

      <!-- When in Edit mode -->
      <Button
        id="btnCancelEdit"
        text="Cancel"
        icon="sap-icon://cancel"
        type="Transparent"
        press=".onCancelEdit"
        visible="{ui>/isEditMode}"
        class="cursorPointer sapUiTinyMarginEnd" />
      <Button
        id="btnSaveEdit"
        text="Save"
        icon="sap-icon://save"
        type="Emphasized"
        press=".onSaveEdit"
        visible="{ui>/isEditMode}"
        class="cursorPointer" />
    </headerContent>
    <content>
      <VBox class="sapUiSmallMargin">
        <!-- Sales Order Header (matching screenshot layout) -->
        <HBox
          id="salesOrderHeaderContainer"
          justifyContent="SpaceBetween"
          alignItems="Start"
          wrap="Wrap"
          class="orderDetailHeaderContainer sapUiSmallMarginBottom">
          
          <!-- Left Column: Title, Intro, Attributes, POS Transaction & Delivery Block -->
          <VBox class="orderDetailHeaderLeftColumn sapUiSmallMarginEnd">
            <Title
              text="{= 'Sales Order ' + ${selectedOrder>/salesOrderNo} }"
              titleStyle="H2"
              class="orderDetailHeaderTitle" />
            <Text
              text="{selectedOrder>/orderTypeDesc}"
              class="orderDetailHeaderIntro" />

            <VBox class="orderDetailAttributesList">
              <HBox alignItems="Center" class="orderDetailAttrRow">
                <Text text="Customer:" class="orderDetailAttrLabel sapUiTinyMarginEnd" />
                <Text text="{selectedOrder>/customerName} (BP: {selectedOrder>/customerBp})" class="orderDetailAttrValue" />
              </HBox>

              <HBox alignItems="Center" class="orderDetailAttrRow">
                <Text text="TV License Type:" class="orderDetailAttrLabel sapUiTinyMarginEnd" />
                <Text text="{selectedOrder>/tvLicenseType}" class="orderDetailAttrValue" />
              </HBox>

              <HBox alignItems="Center" class="orderDetailAttrRow">
                <Text text="Order Date:" class="orderDetailAttrLabel sapUiTinyMarginEnd" />
                <Text text="{selectedOrder>/orderDate}" class="orderDetailAttrValue" />
              </HBox>

              <HBox alignItems="Center" class="orderDetailAttrRow">
                <Text text="Shipment Priority:" class="orderDetailAttrLabel sapUiTinyMarginEnd" />
                <Text text="{selectedOrder>/shipmentPriorityText}" class="orderDetailAttrValue" />
              </HBox>

              <!-- POS Transaction: editable ONLY if in edit mode AND posTransaction is blank -->
              <HBox alignItems="Center" class="orderDetailAttrRow sapUiTinyMarginTop">
                <Label text="POS Transaction:" class="orderDetailAttrLabel sapUiTinyMarginEnd" />
                <Text
                  text="{= ${selectedOrder>/posTransaction} || '-' }"
                  visible="{= !${ui>/isEditMode} || !${ui>/isPosBlank} }"
                  class="orderDetailAttrValue" />
                <Input
                  id="inputPosTransaction"
                  value="{selectedOrder>/posTransaction}"
                  placeholder="Enter POS Transaction ID"
                  change=".onPosTransactionChange"
                  visible="{= ${ui>/isEditMode} &amp;&amp; ${ui>/isPosBlank} }"
                  width="220px" />
              </HBox>

              <!-- Delivery Block (Always non-editable) -->
              <HBox alignItems="Center" class="orderDetailAttrRow sapUiTinyMarginTop">
                <Label text="Delivery Block:" class="orderDetailAttrLabel sapUiTinyMarginEnd" />
                <Text
                  text="{= ${selectedOrder>/deliveryBlockText} || (${selectedOrder>/deliveryBlock} === '01' || ${selectedOrder>/deliveryBlock} === 'BLOCKED' || ${selectedOrder>/deliveryBlock} === 'Delivery Blocked' ? 'Delivery Blocked' : 'Delivery Not Blocked') }"
                  class="orderDetailAttrValue" />
              </HBox>
            </VBox>
          </VBox>

          <!-- Right Column: Amount, Statuses & Financial Details (matching screenshot) -->
          <VBox alignItems="End" class="orderDetailHeaderRightColumn">
            <!-- Amount & Unit -->
            <VBox alignItems="End" class="sapUiTinyMarginBottom">
              <Text
                text="{path: 'selectedOrder>/totalAmount', formatter: '.formatter.formatCurrency'}"
                class="orderDetailAmountValue" />
              <Text
                text="{selectedOrder>/currency}"
                class="orderDetailAmountCurrency" />
            </VBox>

            <!-- Statuses -->
            <VBox alignItems="End" class="sapUiSmallMarginBottom">
              <HBox alignItems="Center" justifyContent="End" class="sapUiTinyMarginBottom">
                <core:Icon src="sap-icon://sys-enter-2" color="#16a34a" size="1rem" class="sapUiTinyMarginEnd" />
                <Text text="{selectedOrder>/status}" class="statusCreatedText" />
              </HBox>
              <HBox alignItems="Center" justifyContent="End">
                <core:Icon
                  src="{= ${selectedOrder>/deliveryMethod} === 'CND' ? 'sap-icon://shipping-status' : (${selectedOrder>/deliveryMethod} === 'CNC' ? 'sap-icon://retail-store' : 'sap-icon://map-pin-point') }"
                  color="#0070f2"
                  size="1rem"
                  class="sapUiTinyMarginEnd" />
                <Text text="{selectedOrder>/deliveryMethodTitle}" class="statusDeliveryText" />
              </HBox>
            </VBox>

            <!-- Financial Details directly below statuses (matching screenshot) -->
            <VBox alignItems="End" class="headerFinancialDetailsSection">
              <HBox alignItems="Center" justifyContent="End" class="financialDetailRow sapUiTinyMarginBottom">
                <Text text="Requested Downpayment" class="financialDetailLabel sapUiMediumMarginEnd" />
                <HBox alignItems="Center">
                  <Text
                    text="{path: 'selectedOrder>/financial/requestedDownpayment', formatter: '.formatter.formatCurrency'}"
                    class="financialDetailValue sapUiTinyMarginEnd" />
                  <Text text="{selectedOrder>/currency}" class="financialDetailCurrency" />
                </HBox>
              </HBox>
              <HBox alignItems="Center" justifyContent="End" class="financialDetailRow sapUiTinyMarginBottom">
                <Text text="Received Downpayment" class="financialDetailLabel sapUiMediumMarginEnd" />
                <HBox alignItems="Center">
                  <Text
                    text="{path: 'selectedOrder>/financial/receivedDownpayment', formatter: '.formatter.formatCurrency'}"
                    class="financialDetailValue sapUiTinyMarginEnd" />
                  <Text text="{selectedOrder>/currency}" class="financialDetailCurrency" />
                </HBox>
              </HBox>
              <HBox alignItems="Center" justifyContent="End" class="financialDetailRow">
                <Text text="Total Price of Order (Incl. Tax):" class="financialDetailLabel sapUiMediumMarginEnd" />
                <HBox alignItems="Center">
                  <Text
                    text="{path: 'selectedOrder>/totalAmount', formatter: '.formatter.formatCurrency'}"
                    class="financialDetailValue sapUiTinyMarginEnd" />
                  <Text text="{selectedOrder>/currency}" class="financialDetailCurrency" />
                </HBox>
              </HBox>
            </VBox>
          </VBox>
        </HBox>

        <!-- IconTabBar with Read-Only Display Sections -->
        <IconTabBar
          id="orderDetailTabs"
          expanded="true"
          headerMode="Inline"
          tooltip="Sales Order Details Navigation Tabs"
          class="orderDetailIconTabBar sapUiResponsiveContentPadding">
          <items>
            <!-- Tab 1: General Header Information -->
            <IconTabFilter
              id="tabGeneralInfo"
              text="General Information"
              icon="sap-icon://hint"
              tooltip="General Information &amp; Header Data">
              <Panel headerText="Order Header Configuration" class="fioriStandardBorderPanel sapUiSmallMarginBottom">
                <content>
                  <l:Grid defaultSpan="XL3 L3 M6 S12" class="sapUiSmallMargin">
                    <VBox class="customerSearchFieldGroup">
                      <Label text="Sales Order Number:" class="customerSearchFieldLabel textMutedBold" />
                      <Text text="{selectedOrder>/salesOrderNo}" class="boldText" />
                    </VBox>

                    <VBox class="customerSearchFieldGroup">
                      <Label text="Order Date:" class="customerSearchFieldLabel textMutedBold" />
                      <Text text="{selectedOrder>/orderDate}" class="boldText" />
                    </VBox>

                    <VBox class="customerSearchFieldGroup">
                      <Label text="Sales Order Type:" class="customerSearchFieldLabel textMutedBold" />
                      <Text text="{selectedOrder>/orderTypeDesc}" class="boldText" />
                    </VBox>

                    <VBox class="customerSearchFieldGroup">
                      <Label text="TV License Type:" class="customerSearchFieldLabel textMutedBold" />
                      <ObjectStatus text="{selectedOrder>/tvLicenseType}" state="Information" class="boldText" />
                    </VBox>

                    <VBox class="customerSearchFieldGroup">
                      <Label text="PO / Application Number:" class="customerSearchFieldLabel textMutedBold" />
                      <Text text="{selectedOrder>/poNumber}" class="boldText" />
                    </VBox>

                    <VBox class="customerSearchFieldGroup">
                      <Label text="Sales Organization:" class="customerSearchFieldLabel textMutedBold" />
                      <Text text="{selectedOrder>/salesOrg}" class="boldText" />
                    </VBox>

                    <VBox class="customerSearchFieldGroup">
                      <Label text="Payment Terms:" class="customerSearchFieldLabel textMutedBold" />
                      <Text text="{selectedOrder>/paymentTerms}" class="boldText" />
                    </VBox>

                    <VBox class="customerSearchFieldGroup">
                      <Label text="Incoterms:" class="customerSearchFieldLabel textMutedBold" />
                      <Text text="{selectedOrder>/incoterms}" class="boldText" />
                    </VBox>
                  </l:Grid>
                </content>
              </Panel>
            </IconTabFilter>

            <!-- Tab 2: Customer & Delivery Details -->
            <IconTabFilter
              id="tabCustomerShipping"
              text="Customer &amp; Shipping"
              icon="sap-icon://shipping-status"
              tooltip="Customer Details and Shipping Information">
              <l:Grid defaultSpan="XL6 L6 M12 S12" class="sapUiSmallMarginBottom">
                <!-- Customer Details (Non-editable) -->
                <Panel headerText="Customer Details (Sold-To Party)" class="fioriStandardBorderPanel">
                  <content>
                    <VBox class="sapUiSmallMargin">
                      <HBox justifyContent="SpaceBetween" alignItems="Center" class="priceRow sapUiSmallMarginBottom">
                        <Text text="Customer Name:" class="priceRowLabel" />
                        <Text text="{selectedOrder>/customerName}" class="boldText" />
                      </HBox>
                      <HBox justifyContent="SpaceBetween" alignItems="Center" class="priceRow sapUiSmallMarginBottom">
                        <Text text="Business Partner (BP):" class="priceRowLabel" />
                        <Text text="{selectedOrder>/customerBp}" class="boldText" />
                      </HBox>
                      <HBox justifyContent="SpaceBetween" alignItems="Center" class="priceRow sapUiSmallMarginBottom">
                        <Text text="ID / Passport Number:" class="priceRowLabel" />
                        <Text text="{selectedOrder>/customerIdNumber}" class="boldText" />
                      </HBox>
                      <HBox justifyContent="SpaceBetween" alignItems="Center" class="priceRow sapUiSmallMarginBottom">
                        <Text text="Contact Number:" class="priceRowLabel" />
                        <Text text="{selectedOrder>/customerMobile}" class="boldText" />
                      </HBox>
                      <HBox justifyContent="SpaceBetween" alignItems="Center" class="priceRow sapUiSmallMarginBottom">
                        <Text text="Email Address:" class="priceRowLabel" />
                        <Text text="{selectedOrder>/customerEmail}" class="boldText" />
                      </HBox>
                    </VBox>
                  </content>
                </Panel>

                <!-- Shipping & Destination -->
                <Panel headerText="Shipping &amp; Fulfillment" class="fioriStandardBorderPanel">
                  <content>
                    <VBox class="sapUiSmallMargin">
                      <!-- Delivery Method: Editable in edit mode -->
                      <HBox justifyContent="SpaceBetween" alignItems="Center" class="priceRow sapUiSmallMarginBottom">
                        <Text text="Delivery Method:" class="priceRowLabel" />
                        <Text text="{selectedOrder>/deliveryMethodTitle}" class="boldText" visible="{= !${ui>/isEditMode} }" />
                        <Select selectedKey="{selectedOrder>/deliveryMethod}" change=".onDeliveryMethodSelectChange" visible="{ui>/isEditMode}" width="220px">
                          <core:Item key="CND" text="Delivery (CND)" />
                          <core:Item key="CNC" text="Click &amp; Collect (CNC)" />
                          <core:Item key="CNP" text="BOPIS (CNP)" />
                        </Select>
                      </HBox>

                      <HBox justifyContent="SpaceBetween" alignItems="Center" class="priceRow sapUiSmallMarginBottom">
                        <Text text="Delivery Type:" class="priceRowLabel" />
                        <Text text="{selectedOrder>/deliveryType}" class="boldText" />
                      </HBox>

                      <!-- Supplying Site / DC: Editable in edit mode -->
                      <HBox justifyContent="SpaceBetween" alignItems="Center" class="priceRow sapUiSmallMarginBottom">
                        <Text text="Supplying Site / DC:" class="priceRowLabel" />
                        <Text text="{selectedOrder>/supplyingSite}" class="boldText" visible="{= !${ui>/isEditMode} }" />
                        <Input value="{selectedOrder>/supplyingSite}" visible="{ui>/isEditMode}" width="220px" />
                      </HBox>

                      <HBox justifyContent="SpaceBetween" alignItems="Center" class="priceRow sapUiSmallMarginBottom">
                        <Text text="Shipping Point:" class="priceRowLabel" />
                        <Text text="{selectedOrder>/shippingPoint}" class="boldText" />
                      </HBox>

                      <HBox justifyContent="SpaceBetween" alignItems="Center" class="priceRow sapUiSmallMarginBottom">
                        <Text text="Carrier:" class="priceRowLabel" />
                        <Text text="{selectedOrder>/carrier}" class="boldText" />
                      </HBox>

                      <HBox justifyContent="SpaceBetween" alignItems="Center" class="priceRow sapUiSmallMarginBottom">
                        <Text text="Requested Delivery Date:" class="priceRowLabel" />
                        <Text text="{selectedOrder>/requestedDeliveryDate}" class="boldText" />
                      </HBox>

                      <HBox justifyContent="SpaceBetween" alignItems="Center" class="priceRow sapUiSmallMarginBottom">
                        <Text text="Shipment Priority:" class="priceRowLabel" />
                        <Text text="{selectedOrder>/shipmentPriorityText}" class="boldText" />
                      </HBox>

                      <HBox justifyContent="SpaceBetween" alignItems="Start" class="priceRow">
                        <Text text="Destination Address:" class="priceRowLabel" />
                        <Text text="{selectedOrder>/deliveryAddress}" class="boldText" />
                      </HBox>
                    </VBox>
                  </content>
                </Panel>
              </l:Grid>
            </IconTabFilter>

            <!-- Tab 3: Cart Summary (Items + Totals) -->
            <IconTabFilter
              id="tabCartSummary"
              text="Cart Summary"
              count="{= ${selectedOrder>/items} ? ${selectedOrder>/items}.length : 0 }"
              icon="sap-icon://cart"
              tooltip="Cart Summary, Line Items and Pricing Totals">
              <VBox>
                <!-- Line Items Table -->
                <Panel class="fioriStandardBorderPanel sapUiSmallMarginBottom">
                  <headerToolbar>
                    <Toolbar>
                      <core:Icon src="sap-icon://product" color="#0070f2" class="sapUiTinyMarginEnd" />
                      <Title
                        text="{= 'Ordered Products &amp; Services (' + ((${selectedOrder>/items} || []).length) + ')' }"
                        titleStyle="H5"
                        class="boldText" />
                      <ToolbarSpacer />
                      <Button
                        id="btnAddArticleDetail"
                        text="Add Article"
                        icon="sap-icon://add"
                        type="Emphasized"
                        press=".onOpenAddArticleDialog"
                        visible="{ui>/isEditMode}"
                        class="cursorPointer" />
                    </Toolbar>
                  </headerToolbar>
                  <content>
                    <ScrollContainer
                      horizontal="true"
                      vertical="false"
                      width="100%">
                      <Table
                        id="orderDetailItemsTable"
                        items="{selectedOrder>/items}"
                        noDataText="No articles added yet. Click 'Add Article' to select products from the popup.">
                        <columns>
                          <Column width="65px" hAlign="Center">
                            <Text text="Item" />
                          </Column>
                          <Column width="110px">
                            <Text text="Article" />
                          </Column>
                          <Column width="100px" hAlign="Center">
                            <Text text="Target Qty" />
                          </Column>
                          <Column width="65px" hAlign="Center">
                            <Text text="UM" />
                          </Column>
                          <Column width="220px">
                            <Text text="Description" />
                          </Column>
                          <Column width="110px">
                            <Text text="" />
                          </Column>
                          <Column width="115px" hAlign="End">
                            <Text text="Price/Unit" />
                          </Column>
                          <Column width="115px" hAlign="End">
                            <Text text="Item Price" />
                          </Column>
                          <Column width="125px" hAlign="Center">
                            <Text text="Sales Person ID" />
                          </Column>
                          <Column width="80px" hAlign="Center">
                            <Text text="Site" />
                          </Column>
                          <Column width="115px" hAlign="Center">
                            <Text text="Item Category" />
                          </Column>
                          <Column width="150px">
                            <Text text="Extended Guarantee Product" />
                          </Column>
                          <Column width="180px">
                            <Text text="Rej. Reason" />
                          </Column>
                          <Column width="65px" hAlign="Center" visible="{ui>/isEditMode}">
                            <Text text="Action" />
                          </Column>
                        </columns>
                        <items>
                          <ColumnListItem class="{= ${selectedOrder>isSubItem} ? 'subItemRow' : 'mainItemRow' }">
                            <cells>
                              <Text text="{selectedOrder>item}" />
                              <Text text="{selectedOrder>articleId}" />
                              <HBox alignItems="Center" justifyContent="Center">
                                <Button
                                  icon="sap-icon://less"
                                  type="Transparent"
                                  press=".onDecreaseItemQty"
                                  enabled="{= ${selectedOrder>qty} > 1 }"
                                  visible="{ui>/isEditMode}" />
                                <Text text="{selectedOrder>qty}" class="{= ${ui>/isEditMode} ? 'sapUiTinyMarginBeginEnd' : '' }" />
                                <Button
                                  icon="sap-icon://add"
                                  type="Transparent"
                                  press=".onIncreaseItemQty"
                                  visible="{ui>/isEditMode}" />
                              </HBox>
                              <Text text="{= ${selectedOrder>um} || 'EA' }" />
                              <Text text="{= ${selectedOrder>description} || ${selectedOrder>name} }" class="productTableTitle boldText" />
                              <Link
                                text="value-add"
                                press=".onOpenValueAddPopup"
                                visible="{= !${selectedOrder>isSubItem} &amp;&amp; !${selectedOrder>isValueAdd} }" />
                              <Text text="{path: 'selectedOrder>netPrice', formatter: '.formatter.formatPriceOnly'}" />
                              <Text text="{path: 'selectedOrder>netValue', formatter: '.formatter.formatPriceOnly'}" class="priceTextBold boldText" />
                              <Text text="{= ${selectedOrder>salesPersonId} || 'SP-1042' }" />
                              <Text text="{= ${selectedOrder>site} || ${selectedOrder>/supplyingSite} || 'S101' }" />
                              <Text text="{= ${selectedOrder>itemCat} || (${selectedOrder>isSubItem} ? 'TAPA' : 'TAN') }" />
                              <Text text="{= ${selectedOrder>extendedGuarantee} || (${selectedOrder>isSubItem} ? 'ZEGP-24' : '-') }" />
                              <VBox>
                                <Text
                                  text="{= ${selectedOrder>rejReason} === '01' ? '01 - Out of Stock' : (${selectedOrder>rejReason} === '02' ? '02 - Customer Cancellation' : (${selectedOrder>rejReason} === '03' ? '03 - Price Dispute' : (${selectedOrder>rejReason} === '04' ? '04 - Damaged Goods' : (${selectedOrder>rejReason} === '05' ? '05 - Late Delivery' : (${selectedOrder>rejReason} === '06' ? '06 - Alternative Item' : '- None -'))))) }"
                                  visible="{= !${ui>/isEditMode} }" />
                                <Select
                                  selectedKey="{selectedOrder>rejReason}"
                                  width="100%"
                                  visible="{ui>/isEditMode}"
                                  change=".onRejectionReasonChange">
                                  <core:Item key="-" text="- None -" />
                                  <core:Item key="01" text="01 - Out of Stock" />
                                  <core:Item key="02" text="02 - Customer Cancellation" />
                                  <core:Item key="03" text="03 - Price Dispute" />
                                  <core:Item key="04" text="04 - Damaged Goods" />
                                  <core:Item key="05" text="05 - Late Delivery" />
                                  <core:Item key="06" text="06 - Alternative Item" />
                                </Select>
                              </VBox>
                              <Button
                                icon="sap-icon://delete"
                                type="Transparent"
                                tooltip="Delete Line Item"
                                press=".onRemoveItem"
                                visible="{ui>/isEditMode}" />
                            </cells>
                          </ColumnListItem>
                        </items>
                      </Table>
                    </ScrollContainer>

                    <!-- Order Pricing Totals Bar (matching screenshot) -->
                    <HBox justifyContent="End" class="sapUiSmallMarginTop">
                      <HBox alignItems="Center" wrap="Wrap" class="cartSummaryTotalsBar">
                        <HBox alignItems="Center" class="sapUiSmallMarginEnd">
                          <Text text="Items:" class="sapUiTinyMarginEnd sapUiThemeColor-dim" />
                          <Text text="{= ${selectedOrder>/items} ? ${selectedOrder>/items}.length : 0 }" class="boldText" />
                        </HBox>
                        <HBox alignItems="Center" class="sapUiSmallMarginEnd">
                          <Text text="Net:" class="sapUiTinyMarginEnd sapUiThemeColor-dim" />
                          <Text text="{path: 'selectedOrder>/pricing/netValue', formatter: '.formatter.formatCurrency'}" class="boldText" />
                        </HBox>
                        <HBox alignItems="Center" class="sapUiSmallMarginEnd">
                          <Text text="VAT (15%):" class="sapUiTinyMarginEnd sapUiThemeColor-dim" />
                          <Text text="{path: 'selectedOrder>/pricing/vat', formatter: '.formatter.formatCurrency'}" class="boldText" />
                        </HBox>
                        <HBox alignItems="Center" class="cartSummaryGrandTotalBox">
                          <Text text="Total:" class="sapUiTinyMarginEnd boldText cartGrandTotalLabel" />
                          <Text text="{path: 'selectedOrder>/pricing/total', formatter: '.formatter.formatCurrency'}" class="boldText cartGrandTotalAmount" />
                        </HBox>
                      </HBox>
                    </HBox>
                  </content>
                </Panel>
              </VBox>
            </IconTabFilter>

            <!-- Tab 4: Attachments -->
            <IconTabFilter
              id="tabAttachments"
              text="Attachments"
              count="{= (${selectedOrder>/attachments} || []).length }"
              icon="sap-icon://attachment"
              tooltip="Order Attachments &amp; Documents">
              <VBox>
                <Panel class="fioriStandardBorderPanel sapUiSmallMarginBottom">
                  <headerToolbar>
                    <Toolbar>
                      <core:Icon src="sap-icon://attachment" color="#0070f2" class="sapUiTinyMarginEnd" />
                      <Title
                        text="{= 'Order Attachments (' + ((${selectedOrder>/attachments} || []).length) + ')' }"
                        titleStyle="H5"
                        class="boldText" />
                      <ToolbarSpacer />
                    </Toolbar>
                  </headerToolbar>
                  <content>
                    <VBox class="sapUiSmallMargin">
                      <List
                        id="orderDetailAttachmentsList"
                        items="{selectedOrder>/attachments}"
                        noDataText="No attachments added for this sales order."
                        showSeparators="All"
                        class="sapUiNoContentPadding">
                        <CustomListItem>
                          <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiSmallMargin">
                            <HBox alignItems="Center">
                              <core:Icon
                                src="{=${selectedOrder>isPdf} ? 'sap-icon://pdf-attachment' : 'sap-icon://document'}" 
                                color="{=${selectedOrder>isPdf} ? '#b00' : '#0854a0'}" 
                                size="1.5rem" 
                                class="sapUiSmallMarginEnd sapUiTinyMarginTop" />
                              <VBox>
                                <Link
                                  text="{= ${selectedOrder>Descr} || ${selectedOrder>fileName} || ${selectedOrder>name} || ${selectedOrder>AttaId} || 'Attachment' }"
                                  press=".onAttachmentPress"
                                  design="Emphasized"
                                  wrapping="true"
                                  class="attachmentFileLink" />
                                <HBox alignItems="Center" class="sapUiTinyMarginTop">
                                  <Text
                                    text="{= 'ID: ' + (${selectedOrder>AttaId} || ${selectedOrder>id} || ${selectedOrder>fileName} || ${selectedOrder>name}) }"
                                    class="sapUiTinyMarginEnd attachmentItemMetaText"
                                    visible="{= !!(${selectedOrder>AttaId} || ${selectedOrder>id} || ${selectedOrder>fileName} || ${selectedOrder>name}) }" />
                                  <Text
                                    text="{= '• ' + (${selectedOrder>fileSize} || ${selectedOrder>size} || 'Document') }"
                                    class="sapUiTinyMarginEnd attachmentItemMetaText" />
                                  <Text
                                    text="{= '• ' + (${selectedOrder>uploadDate} || '') }"
                                    class="attachmentItemMetaText"
                                    visible="{= !!${selectedOrder>uploadDate} }" />
                                </HBox>
                              </VBox>
                            </HBox>
                            <HBox alignItems="Center">
                              <Button
                                text="View / Download"
                                icon="sap-icon://download"
                                type="Transparent"
                                press=".onAttachmentPress"
                                tooltip="View or Download Attachment"
                                class="cursorPointer" />
                            </HBox>
                          </HBox>
                        </CustomListItem>
                      </List>
                    </VBox>
                  </content>
                </Panel>
              </VBox>
            </IconTabFilter>
          </items>
        </IconTabBar>
      </VBox>
    </content>
  </Page>
</mvc:View>
