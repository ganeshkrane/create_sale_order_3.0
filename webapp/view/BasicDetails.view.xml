<mvc:View
  controllerName="sap.ui.salesorder.store.controller.BasicDetails"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:f="sap.ui.layout.form">
  <Page
    id="basicDetailsPage"
    title="{i18n>basicDetailsTitle}"
    showNavButton="true"
    navButtonPress=".onNavBack">
    <headerContent>
    </headerContent>
    <content>
      <!-- Guided Step Header -->
      <core:Fragment fragmentName="sap.ui.salesorder.store.view.fragments.StepIndicator" type="XML" />

      <VBox class="sapUiResponsiveMargin">
        <Breadcrumbs>
          <Link text="{i18n>shellHome}" press=".onNavHome" />
          <Link text="{i18n>customerSearchTitle}" press=".onNavToSearch" />
          <Text text="{i18n>basicDetailsTitle}" />
        </Breadcrumbs>
        <Title text="{i18n>basicDetailsTitle}" titleStyle="H3" class="sapUiTinyMarginTop" />
        <Text text="{i18n>basicDetailsStepIndicator}" class="sapUiThemeColor-dim" />

        <!-- Customer Summary Card -->
        <core:Fragment fragmentName="sap.ui.salesorder.store.view.fragments.CustomerHeader" type="XML" />

        <!-- Basic Details Panel  -->
        <Panel
          expandable="false"
          expanded="true"
          class="sapUiSmallMarginTop">
          <headerToolbar>
            <Toolbar>
              <Title text="{i18n>basicDetailsTitle}" titleStyle="H5" />
              <ToolbarSpacer />
            </Toolbar>
          </headerToolbar>
          <content>
            <!-- Form for Individual -->
            <f:SimpleForm
              visible="{= ${appState>/customer/type} === 'Individual'}"
              editable="true"
              layout="ResponsiveGridLayout"
              labelSpanXL="2"
              labelSpanL="2"
              labelSpanM="3"
              labelSpanS="12"
              columnsXL="2"
              columnsL="2"
              columnsM="1">
              <f:content>
                <core:Title text="Personal Contact Information" />
                <Label text="{i18n>titleLabel}" />
                <Select selectedKey="{appState>/customer/title}">
                  <core:Item key="Mr" text="Mr" />
                  <core:Item key="Mrs" text="Mrs" />
                  <core:Item key="Ms" text="Ms" />
                  <core:Item key="Dr" text="Dr" />
                </Select>

                <Label text="{i18n>firstNameLabel}" required="true" />
                <Input value="{appState>/customer/firstName}" liveChange=".onUpdateFullName" />

                <Label text="{i18n>lastNameLabel}" required="true" />
                <Input value="{appState>/customer/lastName}" liveChange=".onUpdateFullName" />

                <Label text="{i18n>mobileLabel}" required="true" />
                <Input value="{appState>/customer/telephone}" />

                <Label text="{i18n>emailLabel}" />
                <Input value="{appState>/customer/email}" type="Email" />

                <core:Title text="System Identification" />
                <Label text="{i18n>preferredLanguageLabel}" />
                <Select selectedKey="{appState>/customer/language}">
                  <core:Item key="English" text="English" />
                  <core:Item key="Afrikaans" text="Afrikaans" />
                  <core:Item key="isiZulu" text="isiZulu" />
                </Select>

                <Label text="{i18n>idPassportLabel}" />
                <Input value="{appState>/customer/idPassport}" />

                <Label text="{i18n>customerTypeLabel}" />
                <Input value="{appState>/customer/type}" editable="false" />

                <Label text="{i18n>businessPartnerLabel}" />
                <Input value="{appState>/customer/bpNumber}" editable="false" />
              </f:content>
            </f:SimpleForm>

            <!-- Form for Company -->
            <f:SimpleForm
              visible="{= ${appState>/customer/type} === 'Company'}"
              editable="true"
              layout="ResponsiveGridLayout"
              labelSpanXL="2"
              labelSpanL="2"
              labelSpanM="3"
              labelSpanS="12"
              columnsXL="2"
              columnsL="2"
              columnsM="1">
              <f:content>
                <core:Title text="Company Details" />
                <Label text="{i18n>companyNameLabel}" required="true" />
                <Input value="{appState>/customer/companyName}" liveChange=".onUpdateCompanyName" />

                <Label text="{i18n>regNoLabel}" required="true" />
                <Input value="{appState>/customer/regNo}" />

                <Label text="{i18n>vatNoLabel}" required="true" />
                <Input value="{appState>/customer/vatNo}" />

                <Label text="{i18n>contactPersonLabel}" />
                <Input value="{appState>/customer/contactPerson}" />

                <core:Title text="Contact &amp; Account" />
                <Label text="{i18n>mobileLabel}" required="true" />
                <Input value="{appState>/customer/telephone}" />

                <Label text="{i18n>emailLabel}" />
                <Input value="{appState>/customer/email}" type="Email" />

                <Label text="{i18n>customerTypeLabel}" />
                <Input value="{appState>/customer/type}" editable="false" />

                <Label text="{i18n>businessPartnerLabel}" />
                <Input value="{appState>/customer/bpNumber}" editable="false" />
              </f:content>
            </f:SimpleForm>

            <!-- Validate / Select Address Button at the end of basic details section -->
            <HBox justifyContent="End" class="sapUiMediumMarginTop">
              <Button
                id="btnValidateSelectAddress"
                text="{i18n>validateSelectAddressBtn}"
                icon="sap-icon://map-2"
                type="Emphasized"
                press=".onValidateAddressClick" />
            </HBox>
          </content>
        </Panel>

        <!-- Backend Info Strip -->
        <HBox class="backendInfoStrip sapUiMediumMarginTop" alignItems="Center">
          <core:Icon src="sap-icon://database" class="sapUiTinyMarginEnd" color="#107e3e" />
          <Text text="BACKEND: Customer data from CRM lookup; BP number passed to plug-in as JSON." />
        </HBox>
      </VBox>
    </content>
    <footer>
      <OverflowToolbar>
        <ToolbarSpacer />
        <Button
          id="btnNextAddress"
          text="{i18n>nextAddressBtn}"
          type="Emphasized"
          press=".onNextToAddressOrConsent" />
        <Button
          id="btnBackToSearchFromDetails"
          text="{i18n>backBtn}"
          press=".onNavBack" />
      </OverflowToolbar>
    </footer>
  </Page>
</mvc:View>
