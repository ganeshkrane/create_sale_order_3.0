<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">
  <Dialog
    id="customerSearchResultsDialog"
    title="{i18n>searchResultsDialogTitle}"
    contentWidth="760px"
    contentHeight="420px"
    resizable="true"
    draggable="true">
    <subHeader>
      <Toolbar>
        <SearchField
          id="customerSearchField"
          value="{appState>/searchFilterValue}"
          placeholder="Enter Customer Name"
          search=".onLiveSearchDialog"
          liveChange=".onLiveSearchDialog"
          width="50%" />
        <ToolbarSpacer />
      </Toolbar>
    </subHeader>
    <content>
      <Table
        id="customerResultsTable"
        items="{customers>/}"
        mode="SingleSelectMaster"
        selectionChange=".onSelectCustomerRow"
        >
        <columns>
          <Column width="130px">
            <Text text="{i18n>colBpNumber}" />
          </Column>
          <Column>
            <Text text="{i18n>colName}" />
          </Column>
          <Column minScreenWidth="Tablet" demandPopin="true">
            <Text text="{i18n>colTelephone}" />
          </Column>
          <Column minScreenWidth="Tablet" demandPopin="true">
            <Text text="{i18n>colEmail}" />
          </Column>
          <Column width="110px">
            <Text text="{i18n>colType}" />
          </Column>
        </columns>
        <items>
          <ColumnListItem>
            <cells>
              <ObjectIdentifier title="{= ${customers>BpId} || ${customers>bpNumber} }" />
              <Text text="{= ${customers>CustomerName} || ${customers>name} || (${customers>fname} + ' ' + ${customers>sname}) }" />
              <Text text="{= ${customers>cellno} || ${customers>Telephone} || ${customers>telephone} }" />
              <Text text="{= ${customers>Email} || ${customers>email} }" />
              <ObjectStatus text="{= ${customers>EmpType} || ${customers>type} || (${customers>coName} ? 'Company' : 'Individual') }" state="{= (${customers>coName} || ${customers>type} === 'Company') ? 'Information' : 'None'}" />
            </cells>
          </ColumnListItem>
        </items>
      </Table>
    </content>
    <buttons>
      <Button
        text="{i18n>selectCustomerBtn}"
        type="Emphasized"
        press=".onConfirmCustomerSelection" />
      <Button
        text="{i18n>customerNotFoundBtn}"
        type="Default"
        press=".onCustomerNotFound" />
      <Button
        text="{i18n>cancelBtn}"
        press=".onCloseSearchResultsDialog" />
    </buttons>
  </Dialog>
</core:FragmentDefinition>
