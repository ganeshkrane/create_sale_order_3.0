<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">
  <HBox
    alignItems="Center"
    justifyContent="SpaceBetween"
    wrap="Wrap"
    class="customerHeaderCard sapUiSmallMarginBottom">
    <HBox alignItems="Center">
      
      <VBox>
        <HBox alignItems="Center">
          <Title text="{appState>/customer/name}" titleStyle="H5" class="sapUiTinyMarginEnd" />
          <ObjectStatus
            text="BP {appState>/customer/bpNumber}"
            state="Information"
            class="bpBadge" />
        </HBox>
        
      </VBox>
    </HBox>
    
  </HBox>
</core:FragmentDefinition>
