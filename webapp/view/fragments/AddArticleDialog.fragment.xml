<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">
  <Dialog
    id="addArticleDialog"
    title="Select Product"
    contentWidth="980px"
    contentHeight="520px"
    resizable="true"
    draggable="true">
    <subHeader>
      <Toolbar>
        <SearchField
          id="searchSelectProduct"
          placeholder="Search by article number, description, category..."
          value="{filterModel>/search}"
          
          search=".onLiveSearchDialogProducts"
          width="100%" />
      </Toolbar>
    </subHeader>
    <content>
      <Table
        id="selectProductTable"
        items="{artList>/results}"
        noDataText="No Products Found"
        mode="SingleSelectMaster"
        selectionChange=".onSelectProductFromDialogRow"
        itemPress=".onSelectProductFromDialogRow"
        class="sapUiSmallMargin">
        <columns>
          <Column width="38%">
            <Text text="Article / Description" />
          </Column>
          <Column width="10%" hAlign="Center">
            <Text text="Site" />
          </Column>
          <Column width="14%" hAlign="Center">
            <Text text="Stock" />
          </Column>
          <Column width="10%" hAlign="Center">
            <Text text="QTY" />
          </Column>
          <Column width="14%" hAlign="End">
            <Text text="Gross Price (VAT)" />
          </Column>
          <Column width="14%" hAlign="Center">
            <Text text="Item Category" />
          </Column>
        </columns>
        <items>
          <ColumnListItem type="Active">
            <cells>
              <VBox class="sapUiTinyMarginTopBottom">
                <HBox alignItems="Center">
                  <Text text="{= ${artList>articleNumber} || ${artList>articleId} }" class="boldText" />
                  <ObjectStatus
                    text="TV Lic Req"
                    state="Warning"
                    inverted="true"
                    class="sapUiTinyMarginBegin"
                    visible="{= ${artList>tvLicReq} === 'Y' }" />
                  <ObjectStatus
                    text="Serialized"
                    state="Information"
                    inverted="true"
                    class="sapUiTinyMarginBegin"
                    visible="{= ${artList>serNoReq} === 'Y' }" />
                </HBox>
                <Text text="{= ${artList>description} || ${artList>name} }" class="sapUiTinyMarginTop" />
               
              </VBox>
              <Text text="{= ${artList>site} || ${artList>articleSite} || 'M001' }" />
              <VBox alignItems="Center">
                <ObjectStatus
                  text="{= (${artList>inStock} !== undefined ? ${artList>inStock} : (${artList>articleAvailQty} || 'In Stock')) + ' EA' }"
                  state="{= (parseInt(${artList>inStock} || ${artList>articleAvailQty} || 0) > 0) ? 'Success' : 'Error' }" />
              </VBox>
              <Text text="{artList>articleAvailQty}" />
              <Text
                text="{path: 'artList>priceVat', formatter: '.formatter.formatPriceOnly'}"
                class="boldText" />
              <Text text="{= ${artList>ItemCatagory} || ${artList>itemCat} || 'TAN' }" />
            </cells>
          </ColumnListItem>
        </items>
      </Table>
    </content>
    <buttons>
      <Button
        text="Close"
        press=".onCloseAddArticleDialog" />
    </buttons>
  </Dialog>
</core:FragmentDefinition>
